# med-usb runtime configuration (key=value, read by launchers and auditgw)
# All paths are relative to the stick root. Servers bind 127.0.0.1 only.
default_model=granite-4.0-h-micro-Q4_K_M.gguf
fallback_model=granite-4.0-h-micro-Q4_K_M.gguf
ctx=8192
threads=auto
llm_port_range=8080-8099
ui_port_range=8180-8199
bind_address=127.0.0.1
offline_strict=true
no_mmap=true
